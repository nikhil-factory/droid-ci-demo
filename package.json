{
  "name": "droid-ci-demo",
  "version": "1.0.0",
  "description": "Demo app for showcasing Droid diagnosing and fixing CI failures (GitHub Actions + Jenkins)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "demo",
    "ci",
    "jenkins",
    "droid"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  }
}
